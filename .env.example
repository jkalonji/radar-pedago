# Copier en .env pour les essais en local (ne jamais committer .env). Sur GitHub : secrets et variables Actions.

# LLM (optionnel : sans clé, classement par règles, sans traduction ni résumé généré)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Plus tard, vLLM de l'école (API compatible OpenAI) : ces trois variables remplacent Groq
# LLM_BASE_URL=http://serveur-gpu.interne:8000/v1
# LLM_API_KEY=
# LLM_MODEL=

# Stockage (optionnel en local : sans lui, data/local.db)
SUPABASE_URL=
SUPABASE_KEY=          # clé service_role / secret, utilisée uniquement côté serveur (GitHub Actions)

# Crossref : adresse de contact transmise à l'API (« polite pool », facultatif mais recommandé)
CROSSREF_MAILTO=
